def add_noise(x, noise_level=0.01):
    return x + np.random.normal(0, noise_level, x.shape)

def randomize_weights(net, std=0.1):
    for v in net.variables:
        v.assign(tf.random.normal(v.shape, stddev=std))

def resample_domain(geom, n_domain):
    return geom.uniform_points(n_domain, seed=None)
def mc_run(mc_id, noise_level=0.01, weight_std=0.1, ec=ec):
    print(f'----- MC {mc_id+1} -----')
    X_noise = add_noise(geomtime.uniform_points(500), noise_level)
    data_mc = dde.data.PDE(
        geomtime,
        cdPINNpde,          # 同一个 PDE 残差函数
        [],
        num_domain=0,
        train_distribution="uniform",
        anchors=X_noise,
        solution=sol,
        num_test=5000,
    )

    # 2. 网络模板
    def fresh_net():
        net = dde.maps.FNN([2]+[20]*3+[1], "tanh", "Glorot normal")
        net.apply_output_transform(output_transform)
        randomize_weights(net, std=weight_std)
        return net

    # 3. 优化器列表
    optimizers = {
        "Adam":     tf.keras.optimizers.Adam(learning_rate=1e-3),
        "Adamax": tf.keras.optimizers.Adamax(learning_rate=1e-3),
        "Nadam": tf.keras.optimizers.Nadam(learning_rate=1e-3),
        "AMSGrad": tf.keras.optimizers.Adam(learning_rate=1e-3, amsgrad=True),
        "CDadam":   CentralDifferenceAdam(learning_rate=1e-3, h=h),
    }

    results = {}          # 存 L2 误差 & 残差
    for name, opt in optimizers.items():
        net  = fresh_net()
        model = dde.Model(data_mc, net)
        model.compile(optimizer=opt, metrics=["l2 relative error"])
        model.train(epochs=ec, display_every=ec+1)

        # 测试集（无噪声）
        x_test = geomtime.uniform_points(1000)
        u_pred = model.predict(x_test)
        l2_err = dde.metrics.l2_relative_error(sol(x_test), u_pred)

        residual = model.predict(x_test, operator=cdPINNpde)
        res_mean = np.mean(np.abs(residual))

        results[name] = (l2_err, res_mean)
    return results


if __name__ == "__main__":
    import tqdm, pandas as pd, seaborn as sns, matplotlib.pyplot as plt

    N_MC = 5                                       # 可自行加大
    records = []                                    # 逐次 append
    for k in tqdm.trange(N_MC):
        run_dict = mc_run(k, noise_level=0.01, weight_std=0.1, ec=ec)
        for opt, (l2, res) in run_dict.items():
            records.append({"optimizer": opt, "L2_error": l2, "Residual": res})

    df = pd.DataFrame(records)

    # 打印均值±标准差
    print("\n========== Monte-Carlo Summary ==========")
    summary = df.groupby("optimizer").agg(
